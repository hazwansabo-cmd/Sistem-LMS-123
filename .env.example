# === Prisma (database) ===
# Supabase PostgreSQL connection (production)
# Replace with your own Supabase project credentials.
# NOTE: if the password contains "@" or other reserved URL chars, URL-encode them
# (e.g. "@" -> "%40") so the connection string parses correctly.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# === Supabase SSR client (auth + PostgREST over HTTPS) ===
# These are PUBLIC vars (NEXT_PUBLIC_*) - safe to expose in the client bundle.
# Find them in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# For local dev with SQLite instead of Supabase, use:
# DATABASE_URL=file:/home/z/my-project/db/custom.db
