# Supabase PostgreSQL connection
# Replace with your own Supabase project credentials.
# NOTE: if the password contains "@" or other reserved URL chars, URL-encode them
# (e.g. "@" -> "%40") so the connection string parses correctly.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project metadata (optional, for future Supabase SDK usage)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
